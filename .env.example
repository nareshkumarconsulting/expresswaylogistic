# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional CRM / n8n webhook for quote, contact, appointment, voice bookings
CONTACT_WEBHOOK_URL=
VOICE_AGENT_WEBHOOK_URL=

# Email fallback when webhook is missing or fails (Resend)
# https://resend.com — verify a sending domain for production
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=sales@expresswaylogistics.com
LEAD_NOTIFY_FROM="ExpressWay Logistic <onboarding@resend.dev>"

# Natural Ava voice (OpenAI TTS) — low cost, much more human than Chrome speak
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# nova | shimmer | coral | sage | alloy | echo | fable | onyx
OPENAI_TTS_VOICE=nova
# tts-1 (cheaper/faster) or tts-1-hd (more natural)
OPENAI_TTS_MODEL=tts-1-hd

# Optional: polish Ava's wording (Groq free tier or OpenAI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

# Command Center demo auth (optional overrides)
# AUTH_EMAIL=ops@expresswaylogistic.com
# AUTH_PASSWORD=expressway
# AUTH_SESSION_SECRET=
