# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Phase 1 — lead persistence)
# Create a project at https://supabase.com, run supabase/migrations/*.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (Phase 3 — Command Center login)
# Uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY server-side (no anon key required).
# Optional — only needed for future browser-side Supabase features:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lead notifications (optional — still fires when Supabase is configured)
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=sales@expresswaylogistics.com
LEAD_NOTIFY_FROM=ExpressWay Logistic <noreply@expresswaylogistic.com>
QUOTE_EMAIL_FROM=ExpressWay Logistic <quotes@expresswaylogistic.com>
QUOTE_EMAIL_REPLY_TO=sales@expresswaylogistics.com

# Email Intelligence — n8n ingest webhook secret
# n8n sends: Authorization: Bearer <secret>  OR  x-email-ingest-secret: <secret>
EMAIL_INGEST_SECRET=

# Demo auth fallback (only used when Supabase Auth env vars are missing)
AUTH_EMAIL=ops@expresswaylogistic.com
AUTH_PASSWORD=expressway
AUTH_SESSION_SECRET=

# Email Intelligence AI (n8n — pick one; Groq/Gemini have free tiers)
# Groq (recommended free): https://console.groq.com → API Keys
GROQ_API_KEY=
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Voice agent (optional)
# GROQ_API_KEY above also enables natural Ava TTS (preferred).
GROQ_TTS_VOICE=hannah
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Optional OpenAI fallback if Groq is unset
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova
VOICE_AGENT_WEBHOOK_URL=

# Retell web voice (optional — browser WebRTC only, no phone number)
# Dashboard: create an agent, enable Web Call, do not attach a phone number.
# Tools POST to {NEXT_PUBLIC_APP_URL}/api/voice-agent/retell/tools
# Header: Authorization: Bearer <RETELL_TOOL_SECRET>
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_TOOL_SECRET=

# Observability (optional)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_CLARITY_ID=
# SENTRY_DSN=

# ── Production n8n (VPS only — see .env.n8n.production.example) ──
# Copy to server as .env.n8n — do NOT commit real values
# N8N_HOST=n8n.expresswaylogistic.com
# N8N_ENCRYPTION_KEY=
# EXPRESSWAY_APP_URL=https://expresswaylogistic.com
