# Production n8n — copy to server as .env.n8n
# NEVER commit .env.n8n with real values to git

# ── n8n public URL (after DNS + HTTPS) ──────────────────────
N8N_HOST=n8n.expresswaylogistic.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.expresswaylogistic.com/

# ── Security (generate once: openssl rand -hex 32) ──────────
# WARNING: Do not change N8N_ENCRYPTION_KEY after first run — credentials will break
N8N_ENCRYPTION_KEY=

# ── ExpressWay production app ───────────────────────────────
# MUST match Vercel production env exactly
EXPRESSWAY_APP_URL=https://expresswaylogistic.com
EMAIL_INGEST_SECRET=

# ── OpenAI (for AI classify node) ───────────────────────────
OPENAI_API_KEY=

# ── Regional ────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# ── Allow {{ $env.VAR }} in workflow expressions ───────────
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ── Optional: basic auth in front of n8n UI (if not using VPN)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=
